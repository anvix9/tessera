              ],
              "description": "Check-out date (ISO)",
              "title": "Check Out"
            },
            "description": "Check-out date (ISO)"
          },
          {
            "name": "guests",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
