  "components": {
    "schemas": {
      "BookingRequest": {
        "properties": {
          "room_id": {
            "type": "string",
            "title": "Room Id"
          },
          "check_in": {
            "type": "string",
            "title": "Check In"
          },
          "check_out": {
            "type": "string",
            "title": "Check Out"
          },
          "guest_name": {
            "type": "string",
            "title": "Guest Name"
          },
          "guest_email": {
            "type": "string",
            "title": "Guest Email"
          },
          "guest_phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guest Phone"
          }
        },
        "type": "object",
        "required": [
          "room_id",
          "check_in",
          "check_out",
          "guest_name",
          "guest_email"
        ],
        "title": "BookingRequest"
      },
      "City": {
        "type": "string",
        "enum": [
          "new_york",
          "paris",
          "tokyo",
          "london",
          "mexico_city"
        ],
        "title": "City"
      },
      "GuestInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "title": "GuestInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hotel": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "city": {
            "$ref": "#/components/schemas/City"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "rating": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Rating"
          },
          "review_count": {
            "type": "integer",
            "title": "Review Count",
            "default": 0
          },
          "amenities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Amenities",
            "default": []
          },
          "price_min": {
            "type": "number",
            "title": "Price Min",
            "default": 0
          },
          "price_max": {
            "type": "number",
            "title": "Price Max",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "city",
          "description",
          "rating"
        ],
        "title": "Hotel"
      },
      "HotelListResponse": {
        "properties": {
          "hotels": {
            "items": {
              "$ref": "#/components/schemas/Hotel"
            },
            "type": "array",
            "title": "Hotels"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "hotels",
          "total"
        ],
        "title": "HotelListResponse"
      },
      "Reservation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "hotel_id": {
            "type": "string",
            "title": "Hotel Id"
          },
          "room_id": {
            "type": "string",
            "title": "Room Id"
          },
          "guest": {
            "$ref": "#/components/schemas/GuestInfo"
          },
          "check_in": {
            "type": "string",
            "title": "Check In"
          },
          "check_out": {
            "type": "string",
            "title": "Check Out"
          },
          "nights": {
            "type": "integer",
            "title": "Nights"
          },
          "total_price": {
            "type": "number",
            "title": "Total Price"
          },
          "status": {
            "$ref": "#/components/schemas/ReservationStatus",
            "default": "pending"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "hotel_id",
          "room_id",
          "guest",
          "check_in",
          "check_out",
          "nights",
          "total_price"
        ],
        "title": "Reservation"
      },
      "ReservationResponse": {
        "properties": {
          "reservation": {
            "$ref": "#/components/schemas/Reservation"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "reservation"
        ],
        "title": "ReservationResponse"
      },
      "ReservationStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "cancelled"
        ],
        "title": "ReservationStatus"
      },
      "RoomListResponse": {
        "properties": {
          "rooms": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rooms"
          },
          "hotel": {
            "$ref": "#/components/schemas/Hotel"
          },
          "check_in": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Check In"
          },
          "check_out": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Check Out"
          }
        },
        "type": "object",
        "required": [
          "rooms",
          "hotel"
        ],
        "title": "RoomListResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
