{
  "openapi": "3.1.0",
  "info": {
    "title": "Subway Booking Simulation",
    "description": "Simulated hotel booking site for Subway compiler development",
    "version": "0.1.0"
  },
  "paths": {
    "/api/hotels": {
      "get": {
        "summary": "Search Hotels",
        "description": "Search hotels with filters. Shows only hotels with available rooms for the given dates.",
        "operationId": "search_hotels_api_hotels_get",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/City"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by city",
              "title": "City"
            },
            "description": "Filter by city"
          },
          {
            "name": "check_in",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Check-in date (ISO format: YYYY-MM-DD)",
              "title": "Check In"
            },
            "description": "Check-in date (ISO format: YYYY-MM-DD)"
          },
          {
            "name": "check_out",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Check-out date (ISO format: YYYY-MM-DD)",
              "title": "Check Out"
            },
            "description": "Check-out date (ISO format: YYYY-MM-DD)"
          },
          {
            "name": "guests",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Number of guests",
              "title": "Guests"
            },
            "description": "Number of guests"
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum price per night",
              "title": "Min Price"
            },
            "description": "Minimum price per night"
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum price per night",
              "title": "Max Price"
            },
            "description": "Maximum price per night"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sort: rating, price_asc, price_desc",
              "default": "rating",
              "title": "Sort By"
            },
            "description": "Sort: rating, price_asc, price_desc"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
